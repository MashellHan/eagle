# Bots daemon configuration. Copy to .env and fill in real values.
# Loaded by `node --env-file-if-exists=.env` (see package.json scripts).
# Never commit a real key; .env is ignored by Git.

# Model endpoint. OpenAI Responses API shape (POST /responses).
BOTS_BASE_URL=http://127.0.0.1:3425/v1
BOTS_API_KEY=REPLACE_WITH_KEY

# Provider id used in bot.json and the protocol's agent.model.provider.
BOTS_PROVIDER=magpie

# Pinned development model. Must exist at BOTS_BASE_URL (GET /models).
BOTS_MODEL=auto/gpt-6-luna
