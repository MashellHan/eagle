{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eagle-devices",
  "main": "src/worker/device-service.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "devices.example.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_REGISTRY",
        "class_name": "DeviceRegistry"
      },
      {
        "name": "DEVICE_EXECUTION",
        "class_name": "DeviceExecution"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceRegistry", "DeviceExecution"]
    }
  ],
  "vars": {
    "BUILD_REVISION": "development"
  }
}
