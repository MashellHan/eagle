{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eagle",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "eagle.hexly.ai",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eagle",
      "database_id": "23d72296-f25a-4a65-9187-4994f42ca39a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 36001,
    "inspector_port": 46001
  },
  "vars": {
    "BUILD_REVISION": "development"
  }
}
