#!/bin/sh
# Fast gate on the staged snapshot: Biome for web/worker/contracts, swift-format
# for the macOS package. Keep it well under 30 seconds.
set -eu
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$staged" ] || exit 0

code=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|mjs|cjs|json|css|html)$' || true)
if [ -n "$code" ]; then
  echo "pre-commit: biome"
  # shellcheck disable=SC2086
  npx --no-install biome check --error-on-warnings $code
fi

if printf '%s\n' "$staged" | grep -q '^apps/macos/.*\.swift$'; then
  echo "pre-commit: swift format"
  if [ -d /Applications/Xcode.app/Contents/Developer ]; then
    export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"
  fi
  if command -v swift >/dev/null 2>&1; then
    (cd apps/macos && swift format lint --strict --recursive Sources Scripts Tests)
  else
    echo "pre-commit: swift not installed, skipping Swift lint" >&2
  fi
fi
