#!/bin/sh
# Full gate before a branch leaves the machine: unit tests, type checks, lint,
# production build, browser automation and the macOS package tests.
set -eu
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: npm run check"
npm run check

echo "pre-push: browser automation"
npm run test:browser

if [ -d apps/macos ]; then
  echo "pre-push: swift tests"
  if [ -d /Applications/Xcode.app/Contents/Developer ]; then
    export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"
  fi
  if [ "$(uname -s)" = Darwin ]; then
    echo "pre-push: native focus"
    npm run test:focus
  fi
  if command -v swift >/dev/null 2>&1; then
    (cd apps/macos && swift test)
  else
    echo "pre-push: swift not installed, skipping the macOS package tests" >&2
  fi
fi
